# Q16
# In the current list, there are 2 students with the highest score.
# Find the highest score first.
# Then print all student names who got that highest score.
top_scorers = []
highest = max(scores)
print(highest)
for i in range(len(scores)):
    if scores[i] == highest:
        print(names[i])
        top_scorers.append(names[i])

# Q17
# Print the result in this format:
# "Top scorer(s): Lydia, Samuel with 95 marks."
names_str = ", ".join(top_scorers)
print(f"top scorer(s): {names_str} with {highest} marks.")

# Q18
# Find all students who got the lowest score.
# Print their names and the score.
low = []
lowest = min(scores)
print(lowest)
for i in range(len(scores)):
    if scores[i] == lowest:
        print(names[i])
        low.append(names[i])
names_stri = ", ".join(low)
print(f"lowest = {names_stri} with {lowest} marks")
# Q19
